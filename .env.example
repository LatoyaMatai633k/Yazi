# ==========================================================
# Yazi Dev — Environment Variables
# Copy this file to .env (at the repo root) for local dev,
# or configure these in your Netlify dashboard.
# ==========================================================

# ----- OpenRouter (AI provider) -----
# Required. Your OpenRouter API key.
# Sign up and get a key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional. Which model to use via OpenRouter. Defaults to openai/gpt-4o-mini.
# Format is provider/model-name as shown on https://openrouter.ai/models
# Examples:
#   openai/gpt-4o-mini     (fast, low cost — default)
#   openai/gpt-4o          (higher quality)
#   anthropic/claude-3-5-haiku  (fast Anthropic alternative)
OPENROUTER_MODEL=openai/gpt-4o-mini

# ----- GitHub -----
# Optional but strongly recommended. Increases GitHub API rate limits
# from 60 to 5,000 requests/hour.
# Create a token at: https://github.com/settings/tokens
# Required scope: public_repo (for public repos), repo (for private repos)
GITHUB_TOKEN=your_github_personal_access_token_here
